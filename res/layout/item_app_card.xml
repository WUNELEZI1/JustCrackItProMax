<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="12dp">

    <ImageView
        android:id="@+id/cardIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/icon_placeholder_bg"
        android:scaleType="fitCenter"
        android:padding="4dp" />

    <TextView
        android:id="@+id/cardName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/md3_on_surface"
        android:textSize="13sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:gravity="center" />

    <TextView
        android:id="@+id/cardDeveloper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/md3_on_surface_variant"
        android:textSize="10sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/cardSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/md3_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="4dp" />
</LinearLayout>
