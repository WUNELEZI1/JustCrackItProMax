<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="12dp"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/histName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/md3_on_surface"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/histStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/histMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/md3_on_surface_variant"
        android:textSize="11sp"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/histTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/md3_outline"
        android:textSize="10sp"
        android:layout_marginTop="4dp" />
</LinearLayout>
