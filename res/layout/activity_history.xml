<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md3_background">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/md3_primary"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/backBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="←"
            android:textSize="18sp"
            android:textColor="@color/md3_on_primary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="0dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="安装记录"
            android:textColor="@color/md3_on_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingStart="8dp" />

        <Button
            android:id="@+id/clearHistoryBtn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="清空"
            android:textSize="12sp"
            android:textColor="@color/md3_on_primary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <ListView
        android:id="@+id/historyList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/md3_surface_variant"
        android:dividerHeight="1dp"
        android:padding="8dp" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="暂无安装记录\n安装应用后会自动记录"
        android:textColor="@color/md3_outline"
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone" />
</LinearLayout>
