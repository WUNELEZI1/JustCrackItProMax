<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 原有主界面内容 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/md3_background">

        <!-- 顶部状态栏 - MD3 Top App Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/md3_primary"
            android:elevation="4dp"
            android:paddingStart="20dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="JCKProMax"
                android:textColor="@color/md3_on_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/menuBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="⋮"
                android:textSize="18sp"
                android:textColor="@color/md3_on_primary"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="0dp" />

            <Button
                android:id="@+id/settingsBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text=">_"
                android:textSize="14sp"
                android:textColor="@color/md3_on_primary"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="0dp" />
        </LinearLayout>

        <!-- 2x2 网格布局 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center">

            <!-- 第一行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <!-- 应用商店 -->
                <LinearLayout
                    android:id="@+id/storeBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_bg"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="应用商店"
                        android:textColor="@color/md3_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="搜索、浏览、安装应用"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="推荐 + 全部应用 + 批量安装"
                        android:textColor="@color/md3_outline"
                        android:textSize="9sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- 浏览器 -->
                <LinearLayout
                    android:id="@+id/browserBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_bg"
                    android:padding="10dp"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="浏览器"
                        android:textColor="@color/md3_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="内置网页浏览器"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="默认首页 Bing 搜索"
                        android:textColor="@color/md3_outline"
                        android:textSize="9sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 第二行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <!-- 直链安装 -->
                <LinearLayout
                    android:id="@+id/broadcastBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_bg"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="直链安装"
                        android:textColor="@color/md3_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="APK直链下载安装"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="自动计算MD5后广播安装"
                        android:textColor="@color/md3_outline"
                        android:textSize="9sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- 作业帮系统工具 -->
                <LinearLayout
                    android:id="@+id/zybosBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_bg"
                    android:padding="10dp"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="系统工具"
                        android:textColor="@color/md3_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="反射调用系统级API"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="安装/管控/系统/硬件等"
                        android:textColor="@color/md3_outline"
                        android:textSize="9sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/footerVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JCKProMax\n仅供学习交流 严禁用于非法用途"
            android:textColor="@color/md3_outline"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_gravity="center"
            android:paddingBottom="16dp" />
    </LinearLayout>

    <!-- ==================== 全屏更新阻断覆盖层 ==================== -->
    <!-- 检测到更新时覆盖所有主界面内容，即使用户按 Home 键再回来也无法看到界面 -->
    <FrameLayout
        android:id="@+id/updateOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="@color/md3_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <TextView
                android:id="@+id/overlayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正在更新..."
                android:textColor="@color/md3_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlayMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="检测到新版本，正在自动下载更新..."
                android:textColor="@color/md3_on_surface_variant"
                android:textSize="14sp"
                android:layout_marginTop="16dp"
                android:gravity="center" />

            <ProgressBar
                android:id="@+id/overlayProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_marginTop="24dp"
                android:max="100"
                android:progress="0"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>