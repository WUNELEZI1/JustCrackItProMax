<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 阴影层 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md3_shadow" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- 卡片主体（向上偏移2dp产生阴影效果） -->
    <item android:top="2dp" android:start="0dp" android:end="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/md3_card_bg" />
            <corners android:radius="16dp" />
            <stroke android:width="0.5dp" android:color="@color/md3_outline_variant" />
        </shape>
    </item>
</layer-list>
